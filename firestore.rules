rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Users: anyone logged in can read their own doc; admins can list all and update any
    match /users/{uid} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow write: if (request.auth != null && request.auth.uid == uid) || isAdmin();
    }

    // Orders: any authenticated user can create/read/update
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null;
    }

    // Products: anyone can read; suppliers manage their own; admins manage all
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        (resource.data.supplierId == request.auth.uid || isAdmin());
    }

    // Payments: only the owning customer or an admin can read their own payment
    // record; only server (admin SDK) ever writes.
    match /payments/{paymentId} {
      allow read: if request.auth != null &&
        (resource.data.customerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Payment transactions / audit logs: internal bookkeeping written only by
    // the Payments module's admin SDK. Admins may read for reconciliation.
    match /paymentTransactions/{txnId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /paymentAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Payment locks: pure internal plumbing for idempotency — never read or
    // written by any client, only the Payments module's admin SDK.
    match /paymentLocks/{orderId} {
      allow read, write: if false;
    }

    // Bookings: authenticated users can read/create/update
    match /bookings/{bookingId} {
      allow read, create, update: if request.auth != null;
    }

    // Payout Requests: users manage their own; admins manage all
    match /payoutRequests/{reqId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }
  }
}
