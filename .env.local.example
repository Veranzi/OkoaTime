# ============================================================
# OkoaTime Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# Firebase Client SDK (Public — safe to expose in browser)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com

# Google Maps API (Public)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Firebase Admin SDK (Server-side only — NEVER expose in browser)
# Paste the entire service account JSON as a single-line string
FIREBASE_ADMIN_SDK_KEY={"type":"service_account","project_id":"..."}

# Firebase Cloud Messaging Server Key (for push notifications)
FIREBASE_SERVER_KEY=your_fcm_server_key

# Safaricom M-Pesa Daraja API
# Set to "production" to use the live Daraja endpoints with your production
# credentials below. Leave as "sandbox" for local/dev testing against
# Safaricom's sandbox environment. This is the ONLY thing that switches
# environments — the Payments module never hardcodes a base URL.

# Optional override; defaults to CustomerBuyGoodsOnline (Till). Set to
# CustomerPayBillOnline instead if MPESA_SHORTCODE is a Paybill number.
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
# The actual Till Number customers pay to (PartyB). Distinct from
# MPESA_SHORTCODE above — Safaricom can issue these as two different numbers
# for the same till (SHORTCODE authenticates the API call; TILL_NUMBER is
# who gets paid).
MPESA_TILL_NUMBER=
# Public copy of MPESA_TILL_NUMBER, shown to customers as a manual fallback
# when STK push fails. Not a secret — keep this equal to MPESA_TILL_NUMBER above.
NEXT_PUBLIC_MPESA_TILL_NUMBER=
# Callback URL must be publicly accessible (use ngrok for local dev).
# In production this MUST be your real HTTPS domain.
MPESA_CALLBACK_URL=https://your-domain.vercel.app/api/payments/mpesa/callback
# Optional — comma-separated IP allowlist for the callback endpoint.
# Leave empty to skip IP checking (Safaricom does not publish a stable IP
# contract, and this is a defense-in-depth extra, not the primary guard).
MPESA_CALLBACK_IP_ALLOWLIST=

# Africa's Talking SMS
AFRICAS_TALKING_API_KEY=your_africas_talking_api_key
AFRICAS_TALKING_USERNAME=sandbox

# Google Gemini API — server-side only, powers the AI stock assistant and
# AI product categorization. Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional override; defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
